# Supabase Configuration
# Get these from your Supabase project dashboard (Project Settings -> API).
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional Umami tracker. Leave both unset to disable behavioral analytics.
# The script is not requested until a storefront visitor grants Analytics consent.
PUBLIC_UMAMI_SCRIPT_URL=""
PUBLIC_UMAMI_WEBSITE_ID=""
# Optional when the script URL is served from a separate Umami host.
PUBLIC_UMAMI_HOST_URL=""

---
import Header from '@/components/Header';
import BottomNav from '@/components/BottomNav';
import StorefrontFooter from '@/components/storefront/StorefrontFooter';
import MotionProvider from '@/components/MotionProvider';
import { fetchLiveSiteSettings, DEFAULT_SITE_SETTINGS } from '@/lib/siteSettings';
import { getStoreOnPrimary } from '@/lib/storeBranding';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pathname: string;
  storeSlug: string;
  image?: string;
  siteName?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Your Store | Storefront',
  description = 'Browse currently available products and order directly from this storefront.',
  pathname,
  storeSlug,
  image,
  siteName = 'Storefront',
  type = 'website'
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (Astro.url.origin || 'https://instastore.local');
const canonicalUrl = new URL(pathname, siteUrl).toString();
let storefrontColor = DEFAULT_SITE_SETTINGS.primaryColor;
try { storefrontColor = (await fetchLiveSiteSettings(storeSlug)).primaryColor; } catch { /* Keep safe default. */ }
const hex = /^#[0-9a-fA-F]{6}$/.test(storefrontColor) ? storefrontColor : '#18231a';
const onColor = getStoreOnPrimary(hex);
const brandStyle = `--store-primary:${hex.toLowerCase()};--store-on-primary:${onColor}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600;6..96,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph for Instagram, Facebook & WhatsApp -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter / Instagram Large Card Previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
  </head>
  <body style={brandStyle} class="storefront-theme bg-background text-on-background antialiased selection:bg-secondary-container selection:text-on-secondary-container min-h-screen flex flex-col pb-[calc(80px+env(safe-area-inset-bottom,0px))] md:pb-0">
    <a href="#content" class="visually-hidden skip-link">Skip to content</a>
    <Header pathname={pathname} storeSlug={storeSlug} client:load />
    <MotionProvider client:load>
      <div id="content" tabindex="-1" class="flex-1 flex flex-col">
        <slot />
      </div>
    </MotionProvider>
    <StorefrontFooter storeSlug={storeSlug} client:load />
    <BottomNav pathname={pathname} storeSlug={storeSlug} client:load />

    <!-- Instagram In-App Browser & Anchor Alignment script -->
    <script is:inline>
      (function () {
        function scrollToHashTarget() {
          var hash = window.location.hash;
          if (!hash || hash.length < 2) return;
          try {
            var target = document.querySelector(hash);
            if (!target) return;

            // Wait a brief tick for dynamic banners & layout to calculate
            setTimeout(function () {
              var rect = target.getBoundingClientRect();
              var headerOffset = 88; // 64px header + banner clearance
              var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
              var targetY = rect.top + scrollTop - headerOffset;

              window.scrollTo({
                top: Math.max(0, targetY),
                behavior: 'smooth'
              });
            }, 60);
          } catch (e) {
            // Ignore invalid selectors
          }
        }

        // Run immediately if hash exists
        if (window.location.hash) {
          if (document.readyState === 'complete') {
            scrollToHashTarget();
          } else {
            window.addEventListener('load', scrollToHashTarget);
          }
        }

        // Also catch runtime hash changes
        window.addEventListener('hashchange', scrollToHashTarget);
      })();
    </script>
  </body>
</html>

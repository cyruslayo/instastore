---
import Layout from '@/layouts/Layout.astro';
import MemberGate from '@/components/storefront/MemberGate';

// Static page; no server-side data needed.
export const prerender = true;

const CONFIRMATION_IMAGE = 'https://lh3.googleusercontent.com/aida-public/AB6AXuAn9KmLXqPHU8VKdPCpRJHZ4xUEfkL8HwnfyO-Eemyr_CsxgtIjn1N0WXOAXIuziXGy0v05vhfldVGOqRywbsKkyblmSyJ3aK0msZ36eKyvZX1GBJgSIMaptMskOnph297iqtP95ATgjFeNio1mZMr3BQajzRbnOdvOJtzN418HHw6p8Bsz-7S9b4HuXugi1USsf3RoTUXcMqCVxUmRK83RRK7lodOAphTUDsb6DmxQYngCOYTitc8THQ';
const ITEM_ONE_IMAGE = 'https://lh3.googleusercontent.com/aida-public/AB6AXuDBJzHiC9BsAg3P5VqyKKHU9Yd_1xcQXnkxFGjMnCNl_IGNf4EmgHJ785SY40w2Ma0bAN4xSuPsFwMLuBDUnN4F7ng4NMLLT6LfIzCSZHICMQeylFrW2DC15OUKROJIGHX5IpXls6R371o8_-YHyzF9_8TpWSw65_uIaneuf60PEklCDfl26gAlu60rR75GfG4kN5pBkzQS2tZExtGcWAVOfakSnPlC5ZelBPpqkwrOB22uLyFLpeuXPg';
const ITEM_TWO_IMAGE = 'https://lh3.googleusercontent.com/aida-public/AB6AXuAgWW_UouV3_Rm3Cmar2OugaJClBF-g2h0ySutzTt70kpI-zfASzuCuCE1PZ72XxQ3C8MArZqGYDhSDtAJ3s5yFCLeFDmKrO_NbgzmK-ppcg4_07UuS3nLCZEFPGSiwGX3rZgWIKxnAOLL1IzNHD4sCXpjRJuLHBxZeWZEYC5uW02Uz-IK2VNO5wIMIKPq-50JYAYSnAvBpwhwJvgsUTl0_QGbZd98vjw798PmP5iIyc7my6nZj8uri0Q';

const naira = new Intl.NumberFormat('en-NG', {
  style: 'currency',
  currency: 'NGN',
  minimumFractionDigits: 2,
});

const ITEM_ONE_PRICE = naira.format(68);
const ITEM_TWO_PRICE = naira.format(45);
const SUBTOTAL_PRICE = naira.format(113);
const TOTAL_PRICE = naira.format(113);
---

<Layout pathname="/checkout/confirmation" title="Order Confirmation | InstaStore">
  <MemberGate client:load>
    <main class="w-full max-w-2xl mx-auto flex flex-col items-center text-center py-section-gap px-margin-mobile md:px-margin-desktop pt-24 md:pt-32">

    <div class="w-32 h-32 sm:w-48 sm:h-48 mb-stack-lg rounded-full overflow-hidden flex items-center justify-center bg-surface-container-low shadow-[0_30px_60px_rgba(24,35,26,0.05)] border border-surface-variant/50">
      <img src={CONFIRMATION_IMAGE} alt="Confirmation" width={192} height={192} referrerpolicy="no-referrer" class="object-cover w-full h-full opacity-90 transition-opacity hover:opacity-100" />
    </div>

    <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-primary mb-stack-sm">Thank You for Your Order</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-md">Your order is being prepared. A confirmation email has been sent to your inbox.</p>

    <div class="w-full bg-surface-container-low rounded-xl p-stack-lg mb-stack-lg border border-surface-variant/30 text-left">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-outline-variant/30 pb-stack-md mb-stack-md">
        <div>
          <span class="font-label-sm text-label-sm text-outline uppercase block mb-1">Order Number</span>
          <span class="font-headline-sm text-headline-sm text-primary">#ORDER-8273</span>
        </div>
        <div class="mt-stack-sm md:mt-0 text-left md:text-right">
          <span class="font-label-sm text-label-sm text-outline uppercase block mb-1">Estimated Delivery</span>
          <span class="font-headline-sm text-headline-sm text-primary">Oct 24 - Oct 26</span>
        </div>
      </div>

      <div class="space-y-stack-sm">
        <div class="flex justify-between items-center py-2">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-surface-container rounded-lg overflow-hidden flex-shrink-0 relative">
              <img src={ITEM_ONE_IMAGE} alt="Tranquility Serum" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover" />
            </div>
            <div>
              <span class="font-body-md text-body-md text-primary block">Tranquility Serum</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Qty: 1</span>
            </div>
          </div>
          <span class="font-body-md text-body-md text-primary">{ITEM_ONE_PRICE}</span>
        </div>

        <div class="flex justify-between items-center py-2">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-surface-container rounded-lg overflow-hidden flex-shrink-0 relative">
              <img src={ITEM_TWO_IMAGE} alt="Purifying Clay Mask" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover" />
            </div>
            <div>
              <span class="font-body-md text-body-md text-primary block">Purifying Clay Mask</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Qty: 1</span>
            </div>
          </div>
          <span class="font-body-md text-body-md text-primary">{ITEM_TWO_PRICE}</span>
        </div>

        <div class="border-t border-outline-variant/30 pt-stack-sm mt-stack-sm">
          <div class="flex justify-between items-center mb-1 text-on-surface-variant">
            <span class="font-body-md text-body-md">Subtotal</span>
            <span class="font-body-md text-body-md">{SUBTOTAL_PRICE}</span>
          </div>
          <div class="flex justify-between items-center mb-1 text-on-surface-variant">
            <span class="font-body-md text-body-md">Shipping</span>
            <span class="font-body-md text-body-md">Free</span>
          </div>
          <div class="flex justify-between items-center pt-2 mt-2 border-t border-outline-variant/30 text-primary font-bold">
            <span class="font-headline-sm text-headline-sm">Total</span>
            <span class="font-headline-sm text-headline-sm">{TOTAL_PRICE}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-stack-md w-full justify-center">
      <a href="/" class="px-8 py-4 bg-primary text-on-primary rounded-full font-label-sm text-label-sm uppercase tracking-widest hover:scale-[1.02] transition-transform duration-300">
        Continue Shopping
      </a>
      <button class="px-8 py-4 border border-outline text-primary rounded-full font-label-sm text-label-sm uppercase tracking-widest hover:bg-surface-container-low transition-colors duration-300">
        View Receipt
      </button>
    </div>
  </main>
  </MemberGate>
</Layout>


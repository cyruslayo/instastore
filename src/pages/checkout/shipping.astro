---
import Layout from '@/layouts/Layout.astro';
import Shipping from '@/components/storefront/Shipping';
import MemberGate from '@/components/storefront/MemberGate';

// Static shell; form logic runs client-side.
export const prerender = true;
---

<Layout pathname="/checkout/shipping" title="Shipping | InstaStore">
  <MemberGate client:load>
    <Shipping client:load />
  </MemberGate>
</Layout>


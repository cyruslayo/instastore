---
import Layout from '@/layouts/Layout.astro';
import MemberGate from '@/components/storefront/MemberGate';

export const prerender = true;
---

<Layout pathname="/portal" title="Member Portal | InstaStore" description="Member dashboard and storefront access.">
  <MemberGate client:load>
    <main class="w-full pt-12 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="rounded-2xl bg-surface-container-low p-6 sm:p-10 md:p-14 border border-secondary/20 botanical-shadow">
        <div class="max-w-2xl space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-secondary-container/40 rounded-full">
            <span class="w-2 h-2 rounded-full bg-secondary"></span>
            <span class="font-label-sm text-xs font-bold uppercase tracking-widest text-secondary">Verified Member Access</span>
          </div>
          <h1 class="font-display-md md:font-display-lg text-display-md md:text-display-lg text-primary">Member Portal</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">Your member verification is active. Browse available products or manage your referral privileges.</p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="/shop" class="px-8 py-3.5 bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-widest rounded-full hover:opacity-90 transition-all">Shop Available Products &rarr;</a>
            <a href="/invite" class="px-8 py-3.5 border border-outline text-primary font-label-sm text-label-sm uppercase tracking-widest rounded-full hover:bg-surface-container transition-colors">Manage Referrals</a>
          </div>
        </div>
      </div>
    </main>
  </MemberGate>
</Layout>

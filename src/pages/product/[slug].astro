---
import Layout from '@/layouts/Layout.astro';
import ProductDetailIsland from '@/components/storefront/ProductDetailIsland';
import { getProductBySlug } from '@/lib/products';
import type { Product } from '@/lib/types';
export const prerender = false;
const { slug } = Astro.params;
let product: Product | null = null;
try { product = await getProductBySlug(String(slug)); } catch (error) { console.warn(`Unable to load product for slug "${slug}":`, error); }
if (!product) return Astro.redirect('/shop');
---
<Layout pathname={`/product/${product.slug}`} title={`${product.name} | InstaStore`} description={product.description} image={product.image}><ProductDetailIsland client:load product={product} /></Layout>

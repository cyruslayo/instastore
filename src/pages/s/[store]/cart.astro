---
import Layout from '@/layouts/Layout.astro';
import StoreUnavailable from '@/components/storefront/StoreUnavailable.astro';
import Cart from '@/components/storefront/Cart';
import { getPublicStoreBySlug } from '@/lib/stores';
import { storePath } from '@/lib/storePaths';

export const prerender = false;

const storeSlug = String(Astro.params.store ?? '');
const store = await getPublicStoreBySlug(storeSlug);
if (!store) Astro.response.status = 404;
---
{store ? (
<Layout pathname={storePath(storeSlug, 'cart')} storeSlug={storeSlug} title={`Your Bag | ${store.name}`} siteName={store.name}><Cart client:load storeSlug={storeSlug} /></Layout>
) : (
  <StoreUnavailable storeSlug={storeSlug} />
)}

---
import Layout from '@/layouts/Layout.astro';
import StoreUnavailable from '@/components/storefront/StoreUnavailable.astro';
import ProductCard from '@/components/storefront/ProductCard.astro';
import { getPublicStoreBySlug } from '@/lib/stores';
import { getActiveProducts } from '@/lib/products';
import { fetchLiveSiteSettings, DEFAULT_SITE_SETTINGS } from '@/lib/siteSettings';
import { storePath } from '@/lib/storePaths';
import type { Product, Store } from '@/lib/types';

export const prerender = false;

const storeSlug = String(Astro.params.store ?? '');
const store: Store | null = await getPublicStoreBySlug(storeSlug);
if (!store) Astro.response.status = 404;

let products: Product[] = [];
let settings = DEFAULT_SITE_SETTINGS;
if (store) {
  try { products = await getActiveProducts(storeSlug); } catch (error) { console.warn('Unable to load active products:', error); }
  try { settings = await fetchLiveSiteSettings(storeSlug); } catch (error) { console.warn('Unable to load storefront settings:', error); }
}
const storeName = settings.storeName.trim() || 'Your Store';
const tagline = settings.tagline.trim();
const homePath = storePath(storeSlug);
const shopPath = storePath(storeSlug, 'shop');
---
{store ? (
<Layout pathname={homePath} storeSlug={storeSlug} title={`${storeName} | Storefront`} description={`Browse products from ${storeName}.`} siteName={storeName}>
  <main class="w-full">
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap md:py-24"><div class="max-w-2xl"><p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary mb-stack-sm">{storeName}</p><h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-primary tracking-tight">{storeName}</h1>{tagline && <p class="font-body-lg text-body-lg text-on-surface-variant mt-stack-md max-w-xl">{tagline}</p>}<p class="font-body-lg text-body-lg text-on-surface-variant mt-stack-md max-w-xl">Browse currently available products and place your order directly.</p><a href={shopPath} class="inline-flex items-center justify-center mt-stack-lg px-6 py-3 rounded-full bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-widest hover:opacity-90 transition-opacity">Shop Available Products</a></div></section>
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pb-section-gap" aria-labelledby="available-products-heading"><div class="flex items-end justify-between gap-4 border-b border-outline-variant/30 pb-stack-sm mb-stack-lg"><div><p class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">{storeName}</p><h2 id="available-products-heading" class="font-headline-md text-headline-md text-primary mt-unit">Available Products</h2></div><a href={shopPath} class="font-label-sm text-label-sm text-secondary hover:text-primary">View all</a></div>{products.length === 0 ? <p class="py-16 text-center font-body-md text-body-md text-on-surface-variant">There are no products available right now. Please check back soon.</p> : <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-gutter items-start">{products.slice(0, 4).map((product) => <ProductCard product={product} storeSlug={storeSlug} />)}</div>}</section>
  </main>
</Layout>
) : (
  <StoreUnavailable storeSlug={storeSlug} />
)}
